#usda 1.0
(
    defaultPrim = "Witness"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Witness" {
    def Xform "Offset" {
        double3 xformOp:translate = (0.125, -0.25, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Mesh "Tetra" {
            uniform token subdivisionScheme = "none"
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 2, 0), (0, 0, 3)]
            int[] faceVertexCounts = [3, 3, 3, 3]
            int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 1, 2, 3, 2, 0, 3]
        }
    }
}
